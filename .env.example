# Copy this file to .env for local development. Never commit the resulting .env.
APP_ENV=development

# Shared PostgreSQL development identity. These values initialize the container and are also used
# by native Python/Miniconda development. Replace them outside a single-user local environment.
POSTGRES_DB=a_stock_lab
POSTGRES_USER=a_stock_lab
POSTGRES_PASSWORD=a_stock_lab

# Windows/host-only published port. PostgreSQL still listens on 5432 inside the container, and
# Docker services always connect to postgres:5432. This workstation reserves the usual alternative
# port 5433 at the OS level, so the checked-in local template uses the verified-free port 55432.
POSTGRES_HOST_PORT=55432

# Optional full override. Leave blank to let a native backend derive
# postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_HOST_PORT>/<POSTGRES_DB>.
# Compose injects its own Docker-network URL and does not use localhost from inside containers.
DATABASE_URL=

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
OPENAI_API_KEY=
MARKET_DATA_API_KEY=
RUNTIME_DATA_DIR=../runtime
LOG_LEVEL=INFO

# Public frontend configuration only. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000
VITE_BASE_PATH=/
