# Copy this file to .env for local development. Never commit the resulting .env.
APP_ENV=development

# Shared PostgreSQL development identity. These values initialize the container and are also used
# by native Python/Miniconda development. Replace them outside a single-user local environment.
POSTGRES_DB=a_stock_lab
POSTGRES_USER=a_stock_lab
POSTGRES_PASSWORD=a_stock_lab

# Windows/host-only published port. PostgreSQL still listens on 5432 inside the container, and
# Docker services always connect to postgres:5432. This workstation reserves the usual alternative
# port 5433 at the OS level, so the checked-in local template uses the verified-free port 55432.
POSTGRES_HOST_PORT=55432

# Optional full override. Leave blank to let a native backend derive
# postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_HOST_PORT>/<POSTGRES_DB>.
# Compose injects its own Docker-network URL and does not use localhost from inside containers.
DATABASE_URL=

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Optional backend-only key for the manual `tail-radar research` CLI diagnostic. The browser's
# on-demand flow ignores this value and requires each user to supply their own key for one request.
# Leave empty for normal browser use, offline development, tests, capture, and screening.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_TIMEOUT_SECONDS=90
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=6000
OPENAI_RESEARCH_MAX_WEB_SEARCH_CALLS=8
OPENAI_RESEARCH_SEARCH_CONTEXT_SIZE=medium

# Paid AI research is disabled by default. Enabling it mounts the single-candidate endpoint. Each
# user must enter their own OpenAI API key in the detail page; the key is used transiently by the
# backend and is not persisted. A non-local deployment must use HTTPS. Never put a key in VITE_*.
TAIL_RADAR_ON_DEMAND_RESEARCH_ENABLED=false
MARKET_DATA_API_KEY=
RUNTIME_DATA_DIR=../runtime

# Market-data reliability. AKShare already retries individual paginated requests; this adapter
# permits only one additional full-call retry by default and waits before making it.
MARKET_DATA_RETRY_ATTEMPTS=2
MARKET_DATA_RETRY_DELAY_SECONDS=5
TAIL_RADAR_INTRADAY_WORKERS=4

# Official full-market snapshot acceptance thresholds. Counts are absolute; ratios are fractions
# from 0 to 1. See docs/market-data.md for definitions and rationale before changing them.
MARKET_SNAPSHOT_MIN_RECORDS=4000
MARKET_SNAPSHOT_MAX_DUPLICATE_SYMBOLS=0
MARKET_SNAPSHOT_MAX_MISSING_SYMBOL_RATIO=0.001
MARKET_SNAPSHOT_MAX_INVALID_PRICE_RATIO=0.005
MARKET_SNAPSHOT_MAX_INVALID_PCT_CHANGE_RATIO=0.005
MARKET_SNAPSHOT_MAX_MALFORMED_ROW_RATIO=0.01
MARKET_SNAPSHOT_MAX_ABS_PCT_CHANGE=1000

# Separate worker schedule policy. The canonical slot is fixed at 14:30:00 Asia/Shanghai.
# Polling controls wake-up precision; the worker never converts a fetch started outside the
# maximum delay into an official 14:30 capture. Preflight does not fetch the full quote universe.
TAIL_RADAR_WORKER_POLL_INTERVAL_SECONDS=5
TAIL_RADAR_WORKER_PREFLIGHT_LEAD_SECONDS=60
TAIL_RADAR_WORKER_MAXIMUM_START_DELAY_SECONDS=30
TAIL_RADAR_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30

LOG_LEVEL=INFO

# Public frontend configuration only. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000
VITE_BASE_PATH=/

# Trend Radar: local scans and static results. No cloud account or keys required.
# Highlight the attention Top-N; scanning always covers the complete listed A-share universe.
TREND_TOP_N=300
TREND_MIN_DAYS=7
TREND_MAX_DAYS=9
TREND_MAX_PULLBACK_DAYS=2
# null disables the optional daily rebound-amplitude cap.
TREND_MAX_SINGLE_PULLBACK_PCT=null
TREND_BASELINE_VOLUME_DAYS=20
TREND_STRONG_VOLUME_RATIO=0.55
TREND_SCHEDULE_TIME=15:45
TREND_TIMEZONE=Asia/Shanghai
TREND_SCHEDULE_POLL_SECONDS=5
TREND_HEARTBEAT_SECONDS=20
TREND_PROVIDER_TIMEOUT_SECONDS=60
TREND_PROVIDER_ATTEMPTS=3
TREND_PROVIDER_PACE_SECONDS=0.3
TREND_MAX_FAILURE_RATIO=0.2
TREND_MAX_CONSECUTIVE_FAILURES=10
