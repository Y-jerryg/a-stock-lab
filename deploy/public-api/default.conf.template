map $http_origin $allowed_origin {
    default "";
    "${PAGES_ORIGIN}" $http_origin;
}
map $http_origin $origin_rejected {
    default 1;
    "" 0;
    "${PAGES_ORIGIN}" 0;
}
# Deliberate global limits: tunnel IP/header spoofing cannot bypass these budgets.
limit_req_zone $server_name zone=public_reads:1m rate=20r/s;
limit_req_zone $server_name zone=public_research:1m rate=6r/m;
limit_conn_zone $server_name zone=research_connections:1m;
log_format public_api '$time_iso8601 $request_method $uri $status $request_time';

server {
    listen 80;
    server_name public-api;
    server_tokens off;
    access_log /dev/stdout public_api;
    error_log /dev/stderr warn;
    client_max_body_size 8k;
    client_body_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_origin http://backend:8000;

    add_header Access-Control-Allow-Origin $allowed_origin always;
    add_header Access-Control-Allow-Methods "GET, HEAD, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Accept, Content-Type, X-Request-ID, X-OpenAI-API-Key" always;
    add_header Access-Control-Expose-Headers "X-Request-ID" always;
    add_header Access-Control-Max-Age 600 always;
    add_header Vary Origin always;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    if ($origin_rejected) { return 403; }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
    location /api/v1/ {
        if ($request_method !~ ^(GET|HEAD|OPTIONS)$) { return 405; }
        if ($request_method = OPTIONS) { return 204; }
        limit_req zone=public_reads burst=40 nodelay;
        include /etc/nginx/snippets/backend-proxy.conf;
    }
    location ~ "^/api/internal/v1/tail-radar/candidates/[0-9a-fA-F-]{36}/research$" {
        if ($request_method !~ ^(POST|OPTIONS)$) { return 405; }
        if ($request_method = OPTIONS) { return 204; }
        limit_req zone=public_research burst=2 nodelay;
        limit_conn research_connections 2;
        include /etc/nginx/snippets/backend-proxy.conf;
    }
    location / { return 404; }
}
